{
	"$schema": "https://json.schemastore.org/electron-builder.json",
	"appId": "com.ocsdesktop.ai",
	"extraMetadata": {
		"name": "ocs-desktop-ai",
		"description": "OCS 浏览器自动化神器，一键浏览器多开，用户脚本环境一键配置。"
	},
	"productName": "OCS Desktop AI",
	"directories": {
		"output": "../../releases"
	},
	"compression": "maximum",
	"appImage": {
		"compression": "gzip"
	},
	"copyright": "Copyright © 2021 ${author}",
	"files": [
		"out/**/*",
		"public/favicon.png",
		"public/favicon.icns",
		"public/favicon.ico",
		"public/icons/**/*",
		"resources/extensions/*.zip",
		"resources/extensions/*.manifest.json",
		"LICENSES/**/*",
		"package.json",
		"node_modules/**/*",
		"!**/*.map",
		"!node_modules/xlsx/dist/{shim.min,xlsx.core.min,xlsx.extendscript,xlsx.full.min,xlsx,xlsx.min,xlsx.mini.min}.js"
	],
	"beforePack": "./scripts/before-pack.js",
	"electronFuses": {
		"enableEmbeddedAsarIntegrityValidation": true,
		"onlyLoadAppFromAsar": true,
		"enableNodeOptionsEnvironmentVariable": false,
		"enableNodeCliInspectArguments": false
	},
	"nsis": {
		"oneClick": true
	},
	"electronLanguages": [
		"en-US",
		"en-GB",
		"zh-CN"
	],
	"publish": null,
	"win": {
		"icon": "public/favicon.png",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "nsis"
			}
		]
	},
	"mac": {
		"icon": "public/favicon.icns",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "dmg"
			}
		]
	},
	"linux": {
		"executableName": "ocs-desktop-ai",
		"icon": "public/icons/512.png",
		"syncDesktopName": true,
		"artifactName": "ocs-ai-${version}-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "AppImage"
			},
			{
				"target": "deb"
			}
		]
	},
	"deb": {
		"depends": [
			"libgtk-3-0 | libgtk-3-0t64",
			"libnotify4",
			"libnss3",
			"libxss1",
			"libxtst6",
			"xdg-utils",
			"libatspi2.0-0 | libatspi2.0-0t64",
			"libuuid1",
			"libsecret-1-0",
			"libgbm1",
			"libxkbcommon0",
			"libasound2 | libasound2t64",
			"gnome-keyring"
		],
		"recommends": [
			"kwallet6"
		]
	}
}
